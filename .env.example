# =================================================================
# AI Video & Voice Transcriber — Environment Configuration Template
# =================================================================

# Database URL
# For local zero-dependency SQLite development (default):
DATABASE_URL=sqlite:///./transcriber.db
# For PostgreSQL in Docker / Production:
# DATABASE_URL=postgresql://transcriber_user:transcriber_password@localhost:5432/transcriber_db

# Google Gemini API Keys (Backend-only. Used for STT transcription and content intelligence)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
TRANSCRIPTION_CHUNK_DURATION=1800

# Default Transcription Provider (gemini)
DEFAULT_TRANSCRIPTION_PROVIDER=gemini

# Cloudinary Storage Credentials (Backend-only. If omitted, local media storage is used automatically)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis & Celery (Optional for local dev, used for distributed worker queues in production)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
JWT_SECRET=supersecret_jwt_key_for_development_replace_in_production_32chars
ENVIRONMENT=development
DEBUG=true
